rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles & Leaderboard
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /card_progress/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Decks
    match /decks/{deckId} {
      allow read: if resource.data.isPublic == true || 
                     (request.auth != null && resource.data.createdBy == request.auth.uid) ||
                     (resource.data.createdBy == '');
      allow create: if request.auth != null;
      // Tightened: Only the actual owner can update or delete
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Cards Subcollection
      match /cards/{cardId} {
        allow read: if get(/databases/$(database)/documents/decks/$(deckId)).data.isPublic == true || 
                       (request.auth != null && get(/databases/$(database)/documents/decks/$(deckId)).data.createdBy == request.auth.uid) ||
                       (get(/databases/$(database)/documents/decks/$(deckId)).data.createdBy == '');
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/decks/$(deckId)).data.createdBy == request.auth.uid ||
          !exists(/databases/$(database)/documents/decks/$(deckId))
        );
      }
    }

    // Study Sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
